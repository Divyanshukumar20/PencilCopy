PORT=3000
NODE_ENV=development
DB_USER=postgres
DB_HOST=localhost
DB_NAME=pencilcopy
DB_PASSWORD=replace_me
DB_PORT=5432
# On Render, use DATABASE_URL instead of the DB_* variables above.
# DATABASE_URL=postgresql://user:password@internal-host/database
ACCESS_TOKEN_SECRET=replace_with_random_64_character_secret
REFRESH_TOKEN_SECRET=replace_with_another_random_64_character_secret
# Exact deployed Vercel origin in production, with no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# Leave empty until Razorpay test credentials are available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
